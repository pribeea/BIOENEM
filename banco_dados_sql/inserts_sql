-- QUESTÃO 340 - ENEM 2024 (Médio) COM IMAGEM
-- =============================================
INSERT INTO Questao (Enunciado, Ano_ENEM, Explicacao, ID_Nivel, ID_Categoria, Imagem) VALUES
('As autoridades sanitárias brasileiras têm se preocupado muito nos últimos anos com o aumento da ocorrência de doenças transmitidas por mosquitos, principalmente arboviroses como chikungunya e zika, que se tornaram epidêmicas ou endêmicas em áreas urbanas. Parte de uma análise da relação entre a urbanização e a incidência dessas doenças está representada no fluxograma. Nesse contexto, como a urbanização está causando riscos à saúde humana?', 
 'ENEM 2024', 
 'A urbanização causa riscos à saúde humana ao diminuir a população de predadores aquáticos naturais, como peixes e outros organismos que se alimentam de larvas de mosquitos. Com a redução desses predadores, as populações de mosquitos vetores (como o Aedes aegypti) aumentam descontroladamente, elevando a incidência de arboviroses como dengue, chikungunya e zika. A destruição de habitats aquáticos, a poluição dos corpos de água e a impermeabilização do solo são consequências da urbanização que afetam diretamente esses predadores, rompendo o equilíbrio ecológico e facilitando a proliferação de mosquitos transmissores de doenças.', 
 2,  -- Médio
 (SELECT ID_Categoria FROM Categoria WHERE Nome_categoria = 'Zoologia'),
 '/static/images/questao340.png');

