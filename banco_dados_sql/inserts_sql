-- =============================================
-- QUESTÃO 341 - ENEM 2005 (Difícil) COM IMAGEM
-- =============================================
INSERT INTO Questao (Enunciado, Ano_ENEM, Explicacao, ID_Nivel, ID_Categoria, Imagem) VALUES
('O desenvolvimento da maior parte das espécies de insetos passa por vários estágios até chegar à fase adulta, quando finalmente estão aptos à reprodução. Esse desenvolvimento é um jogo complexo de hormônios. A ECDISONA promove as mudas (ecdíases), mas o HORMÔNIO JUVENIL impede que o inseto perca suas características de larva. Com o tempo, a quantidade desse hormônio diminui e o inseto chega à fase adulta. Cientistas descobriram que algumas árvores produzem um composto químico muito semelhante ao HORMÔNIO JUVENIL dos insetos. A vantagem de uma árvore que produz uma substância que funcione como HORMÔNIO JUVENIL é que a larva do inseto, ao se alimentar da planta, ingere esse hormônio e', 
 'ENEM 2005', 
 'O hormônio juvenil mantém o inseto na fase larval, impedindo a metamorfose para adulto. Se a larva ingere esse hormônio continuamente, ela nunca chega à fase adulta e, portanto, não se reproduz.', 
 3,  -- Difícil
 (SELECT ID_Categoria FROM Categoria WHERE Nome_categoria = 'Zoologia'),
 '/static/images/questao341.png');

SET @q341 = LAST_INSERT_ID();
INSERT INTO Alternativa (Texto_Alternativa, Alternativa_Correta, ID_Questao) VALUES
('vive sem se reproduzir, pois nunca chega à fase adulta.', 1, @q341),
('vive menos tempo, pois seu ciclo de vida encurta.', 0, @q341),
('vive mais tempo, pois ocorrem poucas mudas.', 0, @q341),
('morre, pois chega muito rápido à fase adulta.', 0, @q341),
('morre, pois não sofrerá mais mudas.', 0, @q341);


-- Quantidade de questões por categoria
SELECT 
    c.Nome_categoria,
    COUNT(q.ID_Questao) as Total_Questoes,
    SUM(CASE WHEN q.Imagem IS NOT NULL THEN 1 ELSE 0 END) as Questoes_com_imagem
FROM Categoria c
LEFT JOIN Questao q ON c.ID_Categoria = q.ID_Categoria
GROUP BY c.ID_Categoria
HAVING Total_Questoes > 0
ORDER BY Total_Questoes DESC;

SELECT * FROM Questao ORDER BY ID_Questao;
