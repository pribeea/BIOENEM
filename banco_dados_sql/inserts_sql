INSERT INTO Questao (Enunciado, Ano_ENEM, Explicacao, ID_Nivel, ID_Categoria) VALUES
('Anualmente, o número de casos de dengue aumenta substancialmente no Brasil, mas ainda não há uma vacina amplamente disponível. Quatro sorotipos do vírus circulam no país e são todos transmitidos pelas fêmeas do mosquito Aedes aegypti. Os casos mais graves evoluem para a fase hemorrágica, que pode levar à morte por choque hipovolêmico. Muitos desses casos acontecem quando o indivíduo contrai a doença pela segunda vez com um sorotipo diferente daquele contra o qual já produziu anticorpos. O que tem dificultado o desenvolvimento de uma vacina para essa doença é a', 
