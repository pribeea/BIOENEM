INSERT INTO Questao (Enunciado, Ano_ENEM, Explicacao, ID_Nivel, ID_Categoria) VALUES
('Animais invertebrados que vivem em regiões de estuário, cujas águas têm grandes variações de salinidade, apresentam estratégias que permitem adaptações a essas variações. Animais que mantêm osmolaridade interna relativamente constante são chamados de osmorreguladores. Já os animais que não controlam ativamente a condição osmótica de seus líquidos corporais, adaptando-se à osmolaridade do ambiente, são chamados de osmoconformadores. Um pesquisador coletou animais de duas espécies de invertebrados, sendo o Animal A um osmorregulador e o Animal B, um osmoconformador. Ambos foram submetidos, em laboratório, a ambientes aquáticos com diferentes osmolaridades. Em cada situação, foi medida a pressão osmótica interna tanto do Animal A como do Animal B. O gráfico que representa corretamente os dados obtidos pelo pesquisador é:', 
 'ENEM 2024 PPL', 
 'Os animais osmorreguladores mantêm a pressão osmótica interna relativamente constante, independentemente das variações de salinidade do ambiente externo. Portanto, o gráfico do Animal A (osmorregulador) deve mostrar uma linha horizontal (constante). Já os animais osmoconformadores não controlam ativamente a osmolaridade de seus líquidos corporais, e sua pressão osmótica interna varia acompanhando a osmolaridade do ambiente. O gráfico do Animal B (osmoconformador) deve mostrar uma linha crescente, proporcional à osmolaridade externa. O gráfico B representa corretamente esses padrões: Animal A com pressão osmótica constante (linha reta) e Animal B com pressão osmótica variando linearmente com a osmolaridade do ambiente. ', 
 2,  -- Médio
