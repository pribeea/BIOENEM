INSERT INTO Questao (Enunciado, Ano_ENEM, Explicacao, ID_Nivel, ID_Categoria) VALUES
('Lobos da espécie Canis lycaon, do leste dos Estados Unidos, estão intercruzando com coiotes (Canis latrans). Além disso, indivíduos presentes na borda oeste da área de distribuição de C. lycaon estão se acasalando também com lobos cinzentos (Canis lupus). Todos esses cruzamentos têm gerado descendentes férteis. Os animais descritos foram classificados como espécies distintas no século XVIII. No entanto, aplicando-se o conceito biológico de espécie, proposto por Ernst Mayr em 1942, e ainda muito usado hoje em dia, esse fato não se confirma, porque', 
